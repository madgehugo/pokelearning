{
  "name": "pokelearning",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web",
    "adapters/ocr-macos"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @pokelearning/server",
    "dev:web": "npm run dev -w @pokelearning/web",
    "build:web": "npm run build -w @pokelearning/web",
    "start": "npm run build:web && npm run start -w @pokelearning/server",
    "send-test": "npm run send-test -w @pokelearning/server",
    "dict:import": "npm run dict:import -w @pokelearning/server",
    "names:import": "npm run names:import -w @pokelearning/server",
    "reprocess": "npm run reprocess -w @pokelearning/server",
    "test": "npm test -w @pokelearning/server && npm test -w @pokelearning/ocr-macos",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/web && tsc -p adapters/ocr-macos",
    "ocr": "npm start -w @pokelearning/ocr-macos --",
    "ocr:build": "npm run build -w @pokelearning/ocr-macos"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
